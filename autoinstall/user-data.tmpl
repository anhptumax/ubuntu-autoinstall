#cloud-config
# =====================================================================
#  Autoinstall cho Ubuntu Desktop 26.04 LTS (amd64)
#
#  KHONG SUA FILE autoinstall/user-data TRUC TIEP.
#  Sua file nay (user-data.tmpl) hoac scripts/post-install.sh,
#  roi chay ./build.sh de sinh lai autoinstall/user-data.
# =====================================================================
autoinstall:
  version: 1

  source:
    id: ubuntu-desktop
    # true = cai luon driver bo sung (NVIDIA, wifi...) neu may can
    search_drivers: true

  # ---------------------------------------------------------------
  # ---------------------------------------------------------------
  #  O DIA — tuong duong "Erase disk and install Ubuntu", khong ma hoa.
  #
  #  !!! CANH BAO !!!
  #  Cai nay XOA SACH o dia va KHONG HOI LAI mot cau nao.
  #  Khong khai 'match' thi trinh cai chon O LON NHAT trong may.
  #  May co them o cung du lieu lon hon o he dieu hanh -> no xoa nham o do.
  #
  #  May nhieu o dia thi chi ro ra, vd:
  #    match:
  #      path: /dev/nvme0n1     # xem bang: lsblk -do NAME,SIZE,MODEL
  #  hoac uu tien o SSD:
  #    match:
  #      ssd: true
  # ---------------------------------------------------------------
  storage:
    layout:
      name: direct

  # ---------------------------------------------------------------
  #  TAI KHOAN — khoi giua 2 moc do ./set-password.sh sinh ra.
  #  Dung sua tay, chay lai script de doi.
  # ---------------------------------------------------------------
  # >>> IDENTITY >>>
  identity:
    hostname: ubuntu-pc
    realname: umaxsoft
    username: umaxsoft
    password: "$6$bQITEJ6JESk4KSqO$Y01xqFxamTUXgviLD4fXF8lRW1NfezPM8Qf1/BwkncGVDiANQpCDKl9zoUduaaI5nIzQmO139bBpYSCAbz780."
  # <<< IDENTITY <<<

  locale: en_US.UTF-8          # doi thanh vi_VN.UTF-8 neu muon giao dien tieng Viet
  timezone: Asia/Ho_Chi_Minh
  keyboard:
    layout: us

  # Trinh cai tu cai codec + driver doc quyen (tuong duong 2 o tick trong wizard)
  codecs:
    install: true
  drivers:
    install: true

  # Cap nhat he thong trong luc cai
  updates: all

  shutdown: reboot

  # ---------------------------------------------------------------
  #  Ghi script cai phan mem + service chay o lan boot dau tien.
  #  Chay o lan boot dau (khong phai trong trinh cai) de chac chan
  #  co mang — ke ca khi may dung wifi va ban moi ket noi sau khi
  #  dang nhap. Service se tu chay lai neu that bai.
  # ---------------------------------------------------------------
  late-commands:
    - |
      set -eu
      install -d -m 0755 /target/usr/local/sbin
      cat > /target/usr/local/sbin/ubuntu-post-install.sh <<'POST_INSTALL_SCRIPT_EOF'
@@POST_INSTALL_SCRIPT@@
      POST_INSTALL_SCRIPT_EOF
      chmod 0755 /target/usr/local/sbin/ubuntu-post-install.sh

      install -d -m 0755 /target/etc/systemd/system
      cat > /target/etc/systemd/system/ubuntu-post-install.service <<'UNIT_EOF'
      [Unit]
      Description=Cai dat phan mem can thiet o lan boot dau tien
      Wants=network-online.target
      After=network-online.target snapd.service
      ConditionPathExists=!/var/lib/ubuntu-post-install.done
      # Khong gioi han so lan thu lai
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/ubuntu-post-install.sh
      TimeoutStartSec=3600
      # Chua co mang (vd. wifi chua ket noi) -> cho 3 phut roi thu lai
      Restart=on-failure
      RestartSec=180
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target
      UNIT_EOF

      # KHONG dung 'curtin in-target' o day: tren bo cai Desktop ISO no luon loi.
      #   https://github.com/canonical/ubuntu-desktop-installer/issues/2401
      #   https://bugs.launchpad.net/subiquity/+bug/2040654
      # Tu tao symlink — dung y het viec 'systemctl enable' lam voi
      # WantedBy=multi-user.target, ma khong can chroot vao he thong dich.
      mkdir -p /target/etc/systemd/system/multi-user.target.wants
      ln -sf /etc/systemd/system/ubuntu-post-install.service \
             /target/etc/systemd/system/multi-user.target.wants/ubuntu-post-install.service
